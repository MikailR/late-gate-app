# Late Gate app. Copy to `.env.local`. Nothing here is required: with no env
# set, the app runs entirely on in-browser mock adapters (`npm run dev`).

# ---------------------------------------------------------------------------
# Rails (MikailR/late-gate). `mock` is the default and needs no URL.
# Set `http` + the base URL to talk to a running rails deployment.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_RAILS_MODE=mock
NEXT_PUBLIC_RAILS_BASE_URL=http://127.0.0.1:47210

# ---------------------------------------------------------------------------
# World Chain. Demo / testnet is Sepolia, chain id 4801 (LOCKED).
# Mainnet is 480 and is documented only in src/lib/rails/chain.ts.
# USDC (Circle, World Chain Sepolia): 0x66145f38cBAC35Ca6F1Dfb4914dF98F1614aeA88
#
# Caveat: MiniKit `pay` / `sendTransaction` inside World App run on mainnet
# (480) with real USDC. The live wallet adapter therefore reads and pays on
# 480 and is gated by NEXT_PUBLIC_WORLD_PAY_ENABLED + a real vault address.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_WORLDCHAIN_CHAIN_ID=4801
# Optional overrides. Defaults come from chain.ts for 4801.
NEXT_PUBLIC_USDC_ADDRESS=
# Vault the premium and LP deposits are sent to. Live pay refuses to run while empty.
NEXT_PUBLIC_LP_VAULT_ADDRESS=
# 1 to let MiniKit pay move real USDC in World App. Off by default.
NEXT_PUBLIC_WORLD_PAY_ENABLED=0

# ---------------------------------------------------------------------------
# World Mini App / World ID. These ids are PUBLIC (Developer Portal values).
# Mini App name in the portal: LateKid. The portal App URL must match the URL
# the app is served from (for the tunnel build: the trycloudflare hostname).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_WORLD_APP_ID=app_6ee0563505d2423eb78b3b69a04714db
NEXT_PUBLIC_WORLD_RP_ID=rp_c79f5bd55a2badf0
NEXT_PUBLIC_WORLD_ACTION=late-gate-ticket
# IDKit `environment` string sent in IDKit.request. "sandbox" opens the World ID
# Sandbox app handoff (prize-track proofs). "production" is the production World
# ID app. Never "staging" (simulator-only). This is NOT the rails server flag
# WORLD_ENV=sandbox.
NEXT_PUBLIC_IDKIT_ENVIRONMENT=sandbox
# Mock mode only: where the browser asks for a server-signed rp_context.
# Defaults to this app's route, which signs with a server-only key if present,
# else proxies to (NEXT_PUBLIC_)RAILS_BASE_URL/api/world/rp-context (rails PR #8),
# else 503. In http mode the rails client calls the rails route directly.
NEXT_PUBLIC_WORLD_RP_CONTEXT_URL=/api/world/rp-context

# ---------------------------------------------------------------------------
# SERVER ONLY. Never NEXT_PUBLIC_. Never commit a real value.
# The RP private signing key (signer 0xf3A67DB4c3946D44A53F40b4751fCbc44fD02869)
# lives on the rails / server. When it is unset here AND RAILS_BASE_URL is
# unset, /api/world/rp-context answers 503 and the Verify screen falls back
# to the orbLegacy stub path.
# ---------------------------------------------------------------------------
WORLD_RP_SIGNING_KEY=
# Server-side rails base for proxying rp_context signing (optional).
RAILS_BASE_URL=
